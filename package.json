{
  "name": "mt-8.6-mr",
  "version": "1.0.0",
  "description": "A minimal reproducer for a multi-tenancy issue in Camunda 8.6.0",
  "main": "index.js",
  "scripts": {
    "test": "npm run all",
    "all": "npx jest --runInBand --detectOpenHandles --noStackTrace",
    "verbose": "npx jest --runInBand --detectOpenHandles --verbose",
    "invalid-credentials": "npx jest --runInBand --detectOpenHandles --testPathPattern invalid-credentials",
    "no-auth": "npx jest --runInBand --detectOpenHandles --testPathPattern noauth",
    "tenant-default": "npx jest --runInBand --detectOpenHandles --testPathPattern default",
    "tenant-green": "npx jest --runInBand --detectOpenHandles --testPathPattern green",
    "expired-token": "npx jest --runInBand --detectOpenHandles --testPathPattern expired-token",
    "auth": "npx jest --runInBand --detectOpenHandles --testPathPattern auth",
    "rest+auth": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*rest)(?=.*auth).*'",
    "grpc+auth": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*grpc)(?=.*auth).*'",
    "rest+noauth": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*rest)(?=.*noauth).*'",
    "grpc+noauth": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*grpc)(?=.*noauth).*'",
    "rest+invalid-credentials": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*rest)(?=.*invalid-credentials).*'",
    "grpc+invalid-credentials": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*grpc)(?=.*invalid-credentials).*'",
    "rest+tenant-default": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*rest)(?=.*default).*'",
    "grpc+tenant-default": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*grpc)(?=.*default).*'",
    "rest+tenant-green": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*rest)(?=.*green).*'",
    "grpc+tenant-green": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*grpc)(?=.*green).*'",
    "rest+expired-token": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*rest)(?=.*expired-token).*'",
    "grpc+expired-token": "npx jest --runInBand --detectOpenHandles --testPathPattern='^(?=.*grpc)(?=.*expired-token).*'",
    "grpc": "npx jest --runInBand --detectOpenHandles --testPathPattern grpc",
    "rest": "npx jest --runInBand --detectOpenHandles --testPathPattern rest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@camunda8/sdk": "^8.6.13",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0"
  }
}
